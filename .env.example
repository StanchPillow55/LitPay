# =============================================================================
# LitPay Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Session & JWT secrets (generate with: openssl rand -base64 32)
SESSION_SECRET=<YOUR_SESSION_SECRET>
JWT_SECRET=<YOUR_JWT_SECRET>

# Logging
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Postgres connection string
# Format: postgresql://username:password@hostname:port/database
POSTGRES_URL=postgresql://user:password@localhost:5432/litpay
POSTGRES_SSL=false

# -----------------------------------------------------------------------------
# Cache & Vectors (Optional for MVP)
# -----------------------------------------------------------------------------
# Redis for caching and embeddings
REDIS_URL=redis://localhost:6379
EMBEDDINGS_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Object Storage (Optional for MVP)
# -----------------------------------------------------------------------------
# S3-compatible storage for uploads and reports
# OBJECT_STORE_BUCKET=<YOUR_BUCKET_NAME>
# OBJECT_STORE_REGION=us-west-1
# OBJECT_STORE_ACCESS_KEY=<YOUR_S3_ACCESS_KEY>
# OBJECT_STORE_SECRET_KEY=<YOUR_S3_SECRET_KEY>
# For local MinIO:
# OBJECT_STORE_ENDPOINT=http://localhost:9000

# -----------------------------------------------------------------------------
# Claude / Anthropic (Optional for MVP)
# -----------------------------------------------------------------------------
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# -----------------------------------------------------------------------------
# x402 / CDP (Coinbase Developer Platform)
# -----------------------------------------------------------------------------
# CDP Wallet credentials
# Get from: https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=<YOUR_CDP_API_KEY_ID>
CDP_API_KEY_SECRET=<YOUR_CDP_API_KEY_SECRET>

# Network configuration
CDP_NETWORK=base-sepolia
# Use 'base-mainnet' for production

# x402 buyer wallet (generated by CDP)
X402_BUYER_WALLET_ID=<YOUR_WALLET_ID>
X402_BUYER_ADDRESS=<YOUR_WALLET_ADDRESS>

# x402 seller configuration
X402_SELLER_PAYTO=<SELLER_WALLET_ADDRESS>
X402_SELLER_URL=http://localhost:3001/enrich/claims
X402_SELLER_PORT=3001

# x402 Facilitator (optional)
# X402_FACILITATOR_URL=https://facilitator.x402.coinbase.com

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_PUBLISHABLE_KEY=<YOUR_STRIPE_PUBLISHABLE_KEY>

# Webhook secret
# For local testing, get from: stripe listen --print-secret
# For production, get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>

# Meter & pricing (get from Stripe billing meters)
STRIPE_METER_ID=<YOUR_STRIPE_METER_ID>
METER_PRICE_ID=<YOUR_METER_PRICE_ID>
STRIPE_PRODUCT_ID=<YOUR_STRIPE_PRODUCT_ID>

# Optional: Customer ID for testing
# STRIPE_CUSTOMER_ID=<YOUR_CUSTOMER_ID>

# -----------------------------------------------------------------------------
# Discovery APIs (Polite Pool)
# -----------------------------------------------------------------------------
# Required for Crossref, OpenAlex, and Unpaywall API requests
# Use your real email for better API access and support
RESEARCH_CONTACT_EMAIL=<YOUR_EMAIL>

# -----------------------------------------------------------------------------
# Local Policy Engine
# -----------------------------------------------------------------------------
# Budget limits in cents (USD)
POLICY_DAILY_BUDGET_CENTS=5000
# $50.00 daily budget

POLICY_SESSION_CAP_CENTS=1500
# $15.00 per session max

POLICY_PER_CALL_MAX_CENTS=500
# $5.00 per enrichment call max

POLICY_PROVIDER_X402_DAILY_CEILING_CENTS=3000
# $30.00 daily ceiling for x402 provider

# Reservation timeout
RESERVATION_TTL_MINUTES=15

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
FEATURE_X402=true
FEATURE_STRIPE_ISSUING=false
FEATURE_EMBEDDED_WALLETS=false

# =============================================================================
# Setup Instructions:
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Replace all <YOUR_...> placeholders with actual values
# 3. For secrets (SESSION_SECRET, JWT_SECRET):
#    openssl rand -base64 32
# 4. Set up Postgres database and update POSTGRES_URL
# 5. Get CDP credentials from https://portal.cdp.coinbase.com/
# 6. Get Stripe keys from https://dashboard.stripe.com/
# 7. Update RESEARCH_CONTACT_EMAIL with your real email
# 8. Run migrations: npm run migrate
# 9. Start server: npm start
# =============================================================================
